<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    tools:context=".chat_screen">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:padding="10dp"
        android:id="@+id/toolbar">

        <ImageButton
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_back"
            android:background="@android:color/transparent"
            app:tint="@color/white"
            android:layout_centerVertical="true"
            android:id="@+id/back_btn"/>

        <include layout="@layout/profile_pic_view"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/back_btn"
            android:layout_centerVertical="true"
            android:id="@+id/profile_pic_layout"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/profile_pic_layout"
            android:layout_toStartOf="@id/video_call_btn"
            android:ellipsize="end"
            android:singleLine="true"
            android:id="@+id/other_username"

            android:maxLines="1"

            />

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:id="@+id/menu_btn"
            android:src="@drawable/ic_baseline_more_vert_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"/>

        <ImageButton
            android:layout_height="40dp"
            android:layout_width="40dp"
            android:layout_toStartOf="@id/menu_btn"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5dp"
            android:id="@+id/video_call_btn"
            android:src="@drawable/ic_baseline_videocam_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"/>

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottom_layout"
        android:id="@+id/chat_recycler_view"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="8dp"
        android:id="@+id/bottom_layout">

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_attach_file"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:id="@+id/attach_file_btn"
            android:padding="8dp"
            />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/attach_file_btn"
            android:layout_toStartOf="@id/message_send_btn"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_round"
            android:elevation="2dp"
            android:hint="Ask Snakchat AI"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:id="@+id/chat_message_input"/>

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/icon_send"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:id="@+id/message_send_btn"
            android:padding="8dp"
            />

    </RelativeLayout>

</RelativeLayout>